# Container job: runs inside a Docker image with all dependencies pre-installed.
# No need to install packages on the worker machines.

universe        = container
container_image = 136.244.224.136:5000/aall/base:latest

executable = evaluate.py
arguments  = --config config.json --seed $(ProcId)

transfer_input_files    = evaluate.py, config.json
transfer_output_files   = result_$(ProcId).json
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

output = out/$(ClusterId).$(ProcId).out
error  = out/$(ClusterId).$(ProcId).err
log    = condor.log

request_cpus   = 1
request_memory = 2G

queue 50
