# GPU job: runs on threadripper or vertex (RTX 5090).
# CUDA_VISIBLE_DEVICES is set automatically by Condor.

universe        = container
container_image = 136.244.224.136:5000/aall/base-cuda:latest

executable = train.py
arguments  = --epochs 50 --batch-size 64

transfer_input_files    = train.py, model.py, data/
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

output = gpu_$(ClusterId).out
error  = gpu_$(ClusterId).err
log    = gpu.log

request_cpus   = 4
request_memory = 16G
request_gpus   = 1

queue 1
